PORT=5050
LOG_LEVEL=info

# Leave DATA_STORE unset to use Neon/PostgreSQL when DATABASE_URL is real.
# Set DATA_STORE=file only when you intentionally want the local JSON fallback.
# DATA_STORE=file

# Optional. Empty means all localhost / 127.0.0.1 / ::1 frontend ports are allowed.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Add this when you are ready to use Neon/PostgreSQL through Prisma.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require"

# Preferred AI provider. Without this, the AI service returns useful deterministic drafts.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_SITE_URL=http://localhost:5173
# OPENROUTER_APP_NAME=CareerLink AI

# Optional fallback provider.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
